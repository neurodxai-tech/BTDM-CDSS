# Copy to .env and fill in. Never commit .env.
# Required. Generate with:  openssl rand -hex 16
POSTGRES_PASSWORD=
# Required, at least 12 characters: the first 'admin' login password.
ADMIN_BOOTSTRAP_PASSWORD=

# Folder your training notebook saves to. It is mounted read-only; new .pt/.pth
# files matching MODEL_WATCH_INCLUDE are imported and validated automatically.
MODEL_TRAINING_DIR="/path/to/Modeltrained"
# Which checkpoints to import (paths relative to MODEL_TRAINING_DIR, comma-separated).
# Ablations, baselines and cross-validation folds are left out on purpose: they
# are experiments, not deployable models (and would add ~5 GB).
MODEL_WATCH_INCLUDE="Modelweights/deployment_BTDM-CDSS/*.pth,Modelweights/main_5seeds/*.pth"
MODEL_WATCH_EXCLUDE=

# MODEL_LOCKED=true  -> the app keeps using the Seed 42 checkpoint; new training
#                       files are imported and validated but NOT used.
#                       Required for the whole of Part 2 (ANIAS external validation).
# MODEL_LOCKED=false -> the newest validated file from the training folder is
#                       used automatically (development only).
MODEL_LOCKED=true
MODEL_AUTO_ACTIVATE=true
MODEL_VERSION=v1.0.0-seed42

# ── Network (defaults are for use on this computer only) ──────────────────
# To serve other computers, put the app behind an HTTPS reverse proxy and set:
#   PUBLIC_APP_URL=https://btdm.example.org        (address doctors open)
#   PUBLIC_API_URL=https://btdm-api.example.org    (address of the API)
#   BIND_ADDRESS=127.0.0.1                         (keep; the proxy connects locally)
# then rebuild: docker compose up -d --build
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
BIND_ADDRESS=127.0.0.1

# ── Accounts ──────────────────────────────────────────────────────────────
# One-time passwords generated for approved doctors (6–16; default 8).
GENERATED_PASSWORD_LENGTH=8
# Passwords doctors choose: length range; a letter and a number are required.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=64
# Automatic sign-out after this many idle minutes.
SESSION_IDLE_MINUTES=30
